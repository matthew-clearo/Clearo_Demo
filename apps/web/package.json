{
	"name": "web",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.20.0"
	},
	"scripts": {
		"generate:api-routes": "node scripts/generate-api-routes.mjs",
		"predev": "npm run generate:api-routes",
		"dev": "react-router dev",
		"prebuild": "npm run generate:api-routes",
		"build": "react-router build",
		"test": "npm run test:unit",
		"test:unit": "vitest run --config vitest.config.ts",
		"test:unit:watch": "vitest --config vitest.config.ts",
		"test:e2e": "playwright test",
		"test:e2e:headed": "playwright test --headed",
		"test:e2e:install": "playwright install --with-deps chromium",
		"pretypecheck": "npm run generate:api-routes",
		"typecheck": "react-router typegen && tsc --noEmit",
		"migrate:validate": "node scripts/validate-migrations.mjs",
		"migrate:bootstrap": "npm run migrate:validate && npm run migrate && npm run migrate:phi",
		"migrate": "node scripts/migrate.mjs main up",
		"migrate:down": "node scripts/migrate.mjs main down",
		"migrate:status": "node scripts/migrate.mjs main status",
		"migrate:create": "node scripts/migrate.mjs main create",
		"migrate:phi": "node scripts/migrate.mjs phi up",
		"migrate:phi:down": "node scripts/migrate.mjs phi down",
		"migrate:phi:status": "node scripts/migrate.mjs phi status",
		"migrate:phi:create": "node scripts/migrate.mjs phi create"
	},
