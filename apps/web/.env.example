# Database
DATABASE_URL=postgresql://user:password@host/database
DATABASE_URL_RLS=postgresql://clearo_app:password@host/database

# Environment
APP_ENV=development
NEXT_PUBLIC_APP_ENV=development
DEMO_MODE=false

# PHI Vault (separate database for encrypted patient data)
PHI_VAULT_DATABASE_URL=postgresql://user:password@host/phi_vault
PHI_ENCRYPTION_KEY=generate_with_openssl_rand_hex_32

# Auth
AUTH_SECRET=generate_with_openssl_rand_hex_32
AUTH_URL=http://localhost:4000
PUBLIC_APP_URL=http://localhost:4000
PUBLIC_APP_HOST=localhost
CLINIC_APP_URL=http://localhost:4000
CLINIC_APP_HOST=clinic.localhost
AUTH_TOKEN_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000
AUTH_TOKEN_CLIENT_KEY=generate_random_secret

# OAuth Providers (optional)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=

# Email
RESEND_API_KEY=
EMAIL_FROM=noreply@clearo.com.au
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:4000

# Google Maps (server-side only - no NEXT_PUBLIC_ prefix)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GOOGLE_MAPS_MAP_ID=your_map_id_optional

# Clinic MFA
MFA_ENCRYPTION_KEY=generate_with_openssl_rand_hex_32
RATE_LIMIT_WHITELISTED_IPS=

# Jobs/Cron
JOB_SECRET=generate_random_secret

# CAPTCHA
HCAPTCHA_SECRET_KEY=

# Referral Storage + Malware Scanning
REFERRAL_FILE_SIGNING_SECRET=generate_random_secret
REFERRAL_MALWARE_SCAN_URL=
REFERRAL_MALWARE_SCAN_API_KEY=
REFERRAL_S3_BUCKET=
REFERRAL_S3_REGION=
REFERRAL_S3_ENDPOINT=
REFERRAL_S3_FORCE_PATH_STYLE=false
REFERRAL_S3_ACCESS_KEY_ID=
REFERRAL_S3_SECRET_ACCESS_KEY=
REFERRAL_S3_KMS_KEY_ID=
AWS_REGION=

# Error Tracking (Sentry)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_RELEASE=

# Optional
APP_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:4000
